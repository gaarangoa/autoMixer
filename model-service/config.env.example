# Optional machine-specific overrides.
# Copy this file to model-service/config.env; config.env is ignored by Git.

# AutoMixer runtime policy: llama.cpp only. Do not change this to Ollama, vLLM,
# or LM Studio.
AUTOMIXER_MODEL_RUNTIME="llama_cpp"

# The existing external deployment. The large weights stay outside this repo.
AUTOMIXER_MODEL_ROOT="$HOME/vLLM"
AUTOMIXER_MODEL_LLAMA_SERVER_BIN="/opt/homebrew/bin/llama-server"
AUTOMIXER_MODEL_LLAMA_FILE="$HOME/vLLM/models/Qwen3.6-35B-A3B-UD-Q5_K_M.gguf"
AUTOMIXER_MODEL_MMPROJ_FILE="$HOME/vLLM/models/mmproj-F16.gguf"

AUTOMIXER_MODEL_HOST="127.0.0.1"
AUTOMIXER_MODEL_PORT="2261"
AUTOMIXER_MODEL_ALIASES="qwen3.6-35b-a3b,qwythos-9b"
AUTOMIXER_MODEL_CONTEXT_SIZE="122880"
AUTOMIXER_MODEL_PARALLEL="1"
AUTOMIXER_MODEL_GPU_LAYERS="99"
AUTOMIXER_MODEL_CACHE_TYPE_K="q8_0"
AUTOMIXER_MODEL_CACHE_TYPE_V="q8_0"
AUTOMIXER_MODEL_CACHE_REUSE="256"
AUTOMIXER_MODEL_FLASH_ATTN="1"

# Extra llama.cpp flags are a Bash array, so each argument remains safely
# separated. Example: AUTOMIXER_MODEL_LLAMA_EXTRA_ARGS=(--cache-ram 4096)
AUTOMIXER_MODEL_LLAMA_EXTRA_ARGS=()
