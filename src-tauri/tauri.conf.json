{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AutoMixer",
  "version": "0.1.0",
  "identifier": "com.automixer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && bash scripts/stage-sidecars.sh",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "AutoMixer",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/automixer/videos/**",
          "$DATA/automixer/recordings/**",
          "$APPDATA/videos/**",
          "$APPDATA/recordings/**",
          "$HOME/**",
          "/Volumes/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/audio-service": "audio-service",
      "resources/hermes-service": "hermes-service",
      "resources/model-service": "model-service",
      "resources/runtime": "runtime"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
