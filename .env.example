PORT=5178
DATA_DIR=./data
# Legacy variable names retained for compatibility. AutoMixer uses llama.cpp,
# and this URL is the llama.cpp model-service endpoint—not Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:2261
OLLAMA_MODEL=qwen3.6-35b-a3b

# Optional explicit paths for external runtime tools. AutoMixer otherwise checks
# bundled locations, ~/.local/bin, standard Homebrew paths, and PATH.
# AUTOMIXER_UV=/path/to/uv
# AUTOMIXER_FFMPEG=/path/to/ffmpeg
# AUTOMIXER_FFPROBE=/path/to/ffprobe
